{% extends 'base.html.twig' %}

{% block title %}Audit index{% endblock %}

{% block body %}
    <h1>Audit index</h1>

    <a href="{{ path('app_auditeur_index')}}">Liste des auditeurs</a>
    <a href="{{ path('app_site_index')}}">Liste des sites</a>
    <a href="{{ path('app_operation_index')}}">Liste des opérations</a>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date_heure_audit</th>
                <th>Score_conformite</th>
                <th>Zone</th>
                <th>actions</th>
                <th>graph</th>
            </tr>
        </thead>
        <tbody>
        {% for audit in audits %}
            <tr>
                <td>{{ audit.id }}</td>
                <td>{{ audit.dateHeureAudit ? audit.dateHeureAudit|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ audit.scoreConformite }}%</td>
                <td>{{ audit.zone }}</td>
                <td>
                    <a href="{{ path('app_audit_show', {'id': audit.id}) }}">show</a>
                    <a href="{{ path('app_audit_edit', {'id': audit.id}) }}">edit</a>
                    <a href="#">Générer PDF</a>
                </td>
                <th>{{ audit.graph }}</th>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}

        </tbody>
    </table>
    <div class="pagination">   
        {{ knp_pagination_render(audits) }}
    </div>

    

{% endblock %}
