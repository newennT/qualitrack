{% extends 'base.html.twig' %}

{% block title %}Liste des audits{% endblock %}

{% block body %}
<main>
    <div class="container">
        <h1>Espace administrateur</h1>

        <div class="boutons-admin">
            <a class="button" href="{{ path('app_auditeur_index')}}">Liste des auditeurs</a>
            <a class="button" href="{{ path('app_site_index')}}">Liste des sites</a>
            <a class="button" href="{{ path('app_operation_index')}}">Liste des opérations</a>
        </div>

        <div class="admin-index">
        <h2>Liste des audits</h2>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Site et zone</th>
                        <th>Auditeur</th>
                        <th>Score</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for audit in audits %}
                    <tr>
                        <td>{{ audit.dateHeureAudit|date('Y-m-d H:i:s') }}</td>
                        <td><span class="site">{{ audit.site.nomSite }}</span> : <span class="zone">{{ audit.zone }}</span></td>
                        <td><span class="prenom">{{ audit.auditeur.prenom }}</span> <span class="prenom">{{ audit.auditeur.nom }}</span></td>
                        <td>{{ audit.scoreConformite }}%</td>
                        
                        <td class="actions">
                            <a href="{{ path('app_audit_edit', {'id': audit.id}) }}">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a href="{{ path('app_audit_pdf', {'id': audit.id}) }}">
                                <i class="fa-solid fa-download"></i>
                            </a>

                            {{ include('audit/_delete_form.html.twig') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucun audit trouvé</td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>
        </div>

        <div class="pagination">   
            {{ knp_pagination_render(audits) }}
        </div>
    </div>

</main>

{% endblock %}
