{% extends 'base.html.twig' %}

{% block title %}Audit{% endblock %}

{% block body %}
    <h1>Audit</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ audit.id }}</td>
            </tr>
            <tr>
                <th>Date_heure_audit</th>
                <td>{{ audit.dateHeureAudit ? audit.dateHeureAudit|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Score_conformite</th>
                <td>{{ audit.scoreConformite }}</td>
            </tr>
            <tr>
                <th>Zone</th>
                <td>{{ audit.zone }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_audit_index') }}">back to list</a>

    <a href="{{ path('app_audit_edit', {'id': audit.id}) }}">edit</a>

    {{ include('audit/_delete_form.html.twig') }}
{% endblock %}
