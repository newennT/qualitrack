<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Audit n°{{ audit.id }}</title>
</head>
<body>
    <h1>Audit n°{{ audit.id }} ({{ audit.scoreConformite }}%)</h1>
    <p class="subtitle"><span style="text-transform: uppercase;">{{ audit.site.getNomSite }}</span> ( {{ audit.zone }}) - {{ audit.site.getMailContact }}</p>

    <div class="informations">
        <h2>Informations</h2>
        <div class="field">
            <div class="title">Site</div>
            <div class="data">{{ audit.site.getNomSite }}</div>
        </div>

        <div class="field">
            <div class="title">Zone</div>
            <div class="data">{{ audit.zone }}</div>
        </div>

        <div class="field">
            <div class="title">Date et heure de l'audit</div>
            <div class="data">{{ audit.dateHeureAudit|date('Y-m-d H:i:s') }}</div>
        </div>

        <div class="field">
            <div class="title">Auditeur</div>
            <div class="data">{{ audit.auditeur.getNom }} {{ audit.auditeur.getPrenom }}</div>
        </div>  
        
    </div>
    
    <div class="operations">
        <h2>Opérations</h2>
        {% for verification in audit.verifications %}
            {% if verification.operation.isEstActif == true %}

            <div class="verification">
                <div class="field">
                    <div class="title">{{ verification.operation.nom }}</div>
                    <div class="description">{{ verification.operation.description }} ({{ verification.operation.critere }})</div>
                    <div class="data">
                        {% if verification.isEstConforme == true %}
                            <span class="conforme">Conforme</span> 
                        {% else %}
                            <span class="non-conforme">Non conforme :</span></br>
                            {{ verification.commentaire }}
                            <div>
                                <img src="{{ absolute_url(asset('uploads/' ~ verification.photo)) }}" alt="Photo de la vérification" width="150">
                            </div>        
                        {% endif %}
                    </div>
                </div>  
            </div>
            {% endif %}
        {% endfor %}
    
    </div>
    
    
    <div class="resultats">
        <h2>Résultats</h2>
        <p>Le score de conformité est de {{ audit.scoreConformite }}%</p>

        <div id="graph-pdf">
            {% if audit.graph %}
                <img src="{{ asset('graph/' ~ audit.graph) }}" alt="Graphique de l'audit" width="400">
            {% else %}
                <p>Aucun graphique disponible</p>
            {% endif %}
        </div>
    </div>
    

    

<style>
    h1{
        font-size: 40px;
        text-align: center;
        margin-bottom: 0;
    }

    .subtitle{
        text-align: center;
        font-weight: bold;
        margin-bottom: 30px;
    }

    body{
        font-family: 'Arial', sans-serif;
        font-size: 12px;
    }

    h2{
        margin: 0;
        margin-bottom: 10px;
        font-size: 30px;
    }

    .informations{
        background-color: #007CBE;
        padding: 20px;
        border-radius: 7px;
        color: #ffffff;
    }

    .informations .title{
        font-weight: bold;
    }

    .informations .field{
        margin-top: 15px;

    }

    .informations .data{
        background-color: #ffffff;
        padding: 5px 8px;
        color: #000000;
        margin-top: 5px;
    }

    .operations{
        margin-top: 20px;
    }

    .verification{
        margin-bottom: 30px;
    }

    .verification .title{
        background-color:rgb(66, 66, 66);
        color: #ffffff;
        font-weight: bold;
        border-radius: 8px 8px 0 0;
        padding: 5px 8px;
    }

    .verification .description{
        color: rgb(139, 139, 139);
        font-size: 9px;
        font-weight: bold;
        padding: 5px 8px;
    }

    .verification .data{
        padding: 5px 8px;
    }

    img{
        margin-top: 5px;
    }

    .conforme{
        color:rgb(2, 124, 2);
        font-weight: bold;
    }

    .non-conforme{
        color: #ff0000;
        font-weight: bold;
    }

    .resultats p{
        font-weight: bold;
    }

</style>

</body>
</html>