{% extends 'base.html.twig' %}

{% block title %}Liste des opérations{% endblock %}

{% block body %}
<main>
    <div class="container">
        <h1>Espace administrateur</h1>

        <div class="boutons-admin">
            <a class="button back-menu" href="{{ path('app_audit_index')}}"><span><<</span> Menu principal</a>
            <a class="button add" href="{{ path('app_operation_new') }}"><i class="fa-regular fa-square-plus"></i>Ajouter une opération</a>
        </div>

        <div class="admin-index">
        <h2>Liste des opérations</h2>

            <table class="table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Actif</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for operation in operations %}
                    <tr>
                        <td>{{ operation.nom }}</td>
                        <td><span class="check">{{ operation.estActif ? '<i class="fa-solid fa-square-check"></i>' : '' }}</span></td>

                        <td>
                            <div class="actions">
                                <a href="{{ path('app_operation_show', {'id': operation.id}) }}">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a href="{{ path('app_operation_edit', {'id': operation.id}) }}">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                {{ include('operation/_delete_form.html.twig') }} 
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">Aucune opération trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="pagination">   
            {{ knp_pagination_render(operations) }}
        </div>


        <a href="{{ path('app_operation_new') }}">Create new</a>
    </div>

</main>
    
{% endblock %}
