{% extends 'base.html.twig' %}

{% set action = app.current_route == 'app_site_new' ? 'Ajouter' : 'Modifier' %}

{% block title %}{{ action }} un site{% endblock %}

{% block body %}
<main>
    <div class="container">
        <h1>Espace administrateur</h1>

        <div class="boutons-admin">
            <a class="button back-menu" href="{{ path('app_site_index')}}"><span><<</span> Retourner à la liste des sites</a>
        </div>

        <h2>{{ action }} un site</h2>

        {# {{ include('site/_form.html.twig') }} #}

        <div class="admin-add">
        {{ form_start(form) }}

            <div class="form-container">
                {{ form_row(form.nom_site) }}
                {{ form_row(form.mail_contact) }}

                <div class="container-boutons avant">
                    <button type="submit">Enregistrer</button>
                </div>
            </div>

        {{ form_end(form) }}
        
        </div>

        {% if app.current_route == 'app_site_edit' %}
            <div class="bouton-supprimer">
                {{ include('site/_delete_form.html.twig') }}
            </div>
        {% endif %}
    </div>

</main>
    
{% endblock %}
