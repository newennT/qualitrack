{% extends 'base.html.twig' %}

{% set action = app.current_route == 'app_auditeur_new' ? 'Ajouter' : 'Modifier' %}

{% block title %}{{ action }} un auditeur{% endblock %}

{% block body %}
<main>
    <div class="container">
        <h1>Espace administrateur</h1>

        <div class="boutons-admin">
            <a class="button back-menu" href="{{ path('app_auditeur_index')}}"><span><<</span> Retourner à la liste des auditeurs</a>
        </div>

        <h2>{{ action }} un auditeur</h2>

        <div class="admin-add">
            {{ form_start(form) }}

            <div class="form-container">
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}

                <div class="container-boutons avant">
                    <button type="submit">Enregistrer</button>
                </div>
            </div>

            {{ form_end(form) }}
        
        </div>

        <div class="bouton-supprimer">
            {{ include('auditeur/_delete_form.html.twig') }}
        </div>

    </div>

</main>
    
{% endblock %}
