<form id="delete-form" method="post" action="{{ path('app_auditeur_delete', {'id': auditeur.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ auditeur.id) }}">
    <button class="btn">Delete</button>
</form>
