{% extends 'base.html.twig' %}

{% block title %}Liste des auditeurs{% endblock %}

{% block body %}
<main>
    <div class="container">
        <h1>Espace administrateur</h1>

        <div class="boutons-admin">
            <a class="button back-menu" href="{{ path('app_audit_index')}}"><span><<</span> Menu principal</a>
            <a class="button add" href="{{ path('app_auditeur_new') }}"><i class="fa-regular fa-square-plus"></i>Ajouter un auditeur</a>
        </div>

        <div class="admin-index">
            <h2>Liste des auditeurs</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for auditeur in auditeurs %}
                    <tr>
                        <td><span class="nom">{{ auditeur.nom }}</span></td>
                        <td>{{ auditeur.prenom }}</td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('app_auditeur_edit', {'id': auditeur.id}) }}"><i class="fa-solid fa-pen-to-square"></i></a>
                                {{ include('auditeur/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="pagination">   
        {{ knp_pagination_render(auditeurs) }}
        </div>

        
    </div>
</main>
{% endblock %}
